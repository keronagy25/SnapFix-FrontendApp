{
  "expo": {
    "name": "SnapFix",
    "slug": "snapfix",
    "version": "1.0.0",
    "icon": "./assets/Logo.png",
    "scheme": "snapfix",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.snapfix.app",
      "config": {
        "googleMapsApiKey": "AIzaSyBFj1U8JmcsYrcOTSt7YB-cIzHx4aWlmD8"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "SnapFix needs your location to find nearby service providers and show your current position on the map.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "SnapFix needs your location to find nearby service providers and show your current position on the map."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1E3A8A"
      },
      "package": "com.snapfix.app",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBFj1U8JmcsYrcOTSt7YB-cIzHx4aWlmD8"
        }
      }
    },
    "plugins": [
      "expo-router",
      "expo-splash-screen",
      [
        "expo-image-picker",
        {
          "photosPermission": "SnapFix needs access to upload photos of your service requests.",
          "cameraPermission": "SnapFix needs camera access to take photos of your service requests."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "SnapFix needs your location to find nearby service providers."
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.snapfix.app",
          "enableGooglePay": true
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a4550c39-e113-4512-b197-1284eb10f656"
      },
      "stripePublishableKey": "pk_test_51TK2JQ3yWHy1kqh30Bywq0OGdXoWKU55V7UxRq9GtoOPllK4DX3oAIWJ4Hc59gxxRfjuRXHsdk7H90dBQdkFD97Z00rta0hBeE"
    }
  }
}
