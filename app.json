{
  "expo": {
    "name": "SnapFix",
    "slug": "snapfix",
    "version": "1.0.0",
    "icon": "./assets/Logo.png",
    "scheme": "snapfix",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.snapfix.app",
      "config": {
        "googleMapsApiKey": "AIzaSyBFj1U8JmcsYrcOTSt7YB-cIzHx4aWlmD8"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "SnapFix needs your location to find nearby service providers and show your current position on the map.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "SnapFix needs your location to find nearby service providers and show your current position on the map."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1E3A8A"
      },
      "package": "com.snapfix.app",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBFj1U8JmcsYrcOTSt7YB-cIzHx4aWlmD8"
        }
      }
    },
    "plugins": [
      "expo-router",
      "expo-splash-screen",
      [
        "expo-image-picker",
        {
          "photosPermission": "SnapFix needs access to upload documents.",
          "cameraPermission": "SnapFix needs camera access."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "SnapFix needs your location to find nearby service providers."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a4550c39-e113-4512-b197-1284eb10f656"
      }
    }
  }
}